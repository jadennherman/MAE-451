# Global Attributes:

# Branches:
SET       wing_span sqrt(wing_area*wing_AR)
SET       wing_chord wing_area/wing_span
SET       fus_diameter fus_length/fus_FR
SET       fus_radius fus_diameter/2
SET       nose_length 0.12
SKBEG     0   0   0   0
   SPLINE    0.25*nose_length   0.661438*fus_radius   0
   SPLINE    0.50*nose_length   0.866025*fus_radius   0
   SPLINE    0.75*nose_length   0.968246*fus_radius   0
   SPLINE    nose_length   fus_radius   0
   LINSEG    nose_length   0   0
   LINSEG    0   0   0
SKEND     0
REVOLVE   0   0   0   1   0   0   360
SET       noseV @volume
SET       nosecg @xcg
SET       noseSwet @area
CYLINDER  nose_length   0   0   fus_length   0   0   fus_radius
