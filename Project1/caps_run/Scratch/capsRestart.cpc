SET       ht_x fus_length-1.5*ht_chord
SET       ht_z 0.035
MARK
UDPRIM    naca   Series   0010   sharpte   1
ROTATEX   90   0   0
SCALE     ht_chord   0   0   0
TRANSLATE ht_x   (-ht_span/2)   ht_z
UDPRIM    naca   Series   0010   sharpte   1
