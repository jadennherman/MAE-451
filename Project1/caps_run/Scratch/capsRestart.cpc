SET       rxV @volume
SET       rxcg @xcg
SET       ail_servo_center_x wing_x+0.70*wing_chord
SET       ail_servo_x ail_servo_center_x-servo_xdim/2
SET       ail_servo_y_left -0.35*wing_span
SET       ail_servo_y_right 0.35*wing_span
SET       ail_servo_z 0.035
BOX       ail_servo_x   (ail_servo_y_left-servo_longdim/2)   ail_servo_z   servo_xdim   servo_longdim   servo_thickness
SET       servoV @volume
SET       ail_left_cg @xcg
BOX       ail_servo_x   (ail_servo_y_right-servo_longdim/2)   ail_servo_z   servo_xdim   servo_longdim   servo_thickness
SET       ail_right_cg @xcg
SET       elev_servo_center_x ht_x+0.65*ht_chord
SET       elev_servo_x elev_servo_center_x-servo_xdim/2
SET       elev_servo_y 0.15*ht_span
SET       elev_servo_z ht_z
BOX       elev_servo_x   (elev_servo_y-servo_longdim/2)   elev_servo_z   servo_xdim   servo_longdim   servo_thickness
SET       elev_cg @xcg
SET       rud_servo_height_fraction 0.20
SET       rud_servo_LE_x vt_x+rud_servo_height_fraction*vt_sweep_offset
SET       rud_servo_local_chord vt_root_chord+rud_servo_height_fraction*(vt_tip_chord-vt_root_chord)
SET       rud_servo_center_x rud_servo_LE_x+0.65*rud_servo_local_chord
SET       rud_servo_x rud_servo_center_x-servo_xdim/2
SET       rud_servo_y 0
SET       rud_servo_z vt_z+rud_servo_height_fraction*vt_height
BOX       rud_servo_x   rud_servo_y   rud_servo_z   servo_xdim   servo_thickness   servo_longdim
SET       rud_cg @xcg

