TRANSLATE ht_x   (ht_span/2)   ht_z
RULE      0   0   0
SET       htailV @volume
SET       htailcg @xcg
SET       htailSwet @area
SET       vt_area 0.08*wing_span*wing_area/fus_length
SET       vt_AR 1.5
SET       vt_taper 0.7
SET       vt_sweep 30
SET       vt_height sqrt(vt_area*vt_AR)
SET       vt_root_chord 2*vt_area/(vt_height*(1+vt_taper))
SET       vt_tip_chord vt_taper*vt_root_chord
SET       vt_sweep_offset vt_height*tand(vt_sweep)
SET       vt_x fus_length-vt_sweep_offset-vt_tip_chord
SET       vt_z fus_radius
MARK
UDPRIM    naca   Series   0010   sharpte   1
SCALE     vt_root_chord   0   0   0
TRANSLATE vt_x   0   vt_z
UDPRIM    naca   Series   0010   sharpte   1
SCALE     vt_tip_chord   0   0   0
TRANSLATE (vt_x+vt_sweep_offset)   0   (vt_z+vt_height)
RULE      0   0   0
SET       vtailV @volume
SET       vtailcg @xcg
SET       vtailSwet @area
SET       motor_length 0.0445
SET       motor_radius 0.0142
SET       prop_radius 0.1016
SET       prop_hub_radius 0.01016
SET       prop_hub_thickness 0.01143
SET       esc_L 0.086
SET       esc_W 0.038
SET       esc_H 0.012
SET       batt_L 0.1310
SET       batt_W 0.0435
SET       batt_H 0.0290
SET       rx_L 0.043
SET       rx_W 0.025
SET       rx_H 0.015
SET       servo_xdim 0.0298
SET       servo_thickness 0.0120
SET       servo_longdim 0.0296
CYLINDER  (-motor_length)   0   0   0   0   0   motor_radius
SET       motorcg @xcg
CYLINDER  (-motor_length-prop_hub_thickness)   0   0   (-motor_length)   0   0   prop_hub_radius
SET       propcg -motor_length-prop_hub_thickness/2
SET       prop_blade_width 0.018
SET       prop_blade_thickness 0.003
BOX       (-motor_length-prop_hub_thickness-prop_blade_thickness)   (-prop_blade_width/2)   (-prop_radius)   prop_blade_thickness   prop_blade_width   (2*prop_radius)
BOX       esc_x   (-esc_W/2)   (-esc_H/2)   esc_L   esc_W   esc_H
SET       escV @volume
SET       esccg @xcg
BOX       batt_x   (-batt_W/2)   (-batt_H/2)   batt_L   batt_W   batt_H
